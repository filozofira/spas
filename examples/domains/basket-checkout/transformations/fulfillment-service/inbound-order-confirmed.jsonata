/* inbound-order-confirmed.jsonata */
/* Transforms order-confirmed (order-service) → CreateShipmentRequest (fulfillment-service) */
/* Creates shipment with order details and shipping address */
{
  "orderId": orderId,
  "customerId": orderId,
  "shippingAddress": {
    "street": shippingAddress.street,
    "city": shippingAddress.city,
    "state": shippingAddress.state,
    "postalCode": shippingAddress.postalCode,
    "country": shippingAddress.country
  }
}
