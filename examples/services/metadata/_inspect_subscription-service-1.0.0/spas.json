{
  "schemaVersion": "design-time-metadata-v1",
  "id": "subscription-service",
  "name": "subscription-service",
  "description": "B2B subscription management service",
  "version": "1.0.0",
  "boundedContext": "subscription",
  "capabilities": [
    "subscription-management"
  ],
  "endpoints": [
    {
      "name": "CreateSubscription",
      "type": "Command",
      "protocol": "Http",
      "methodPath": "/subscriptions",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/create-subscription.schema.json",
      "description": "Creates a new subscription for a customer/product and publishes SubscriptionCreated"
    },
    {
      "name": "ListSubscriptions",
      "type": "Query",
      "protocol": "Http",
      "methodPath": "/subscriptions",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/list-subscriptions.schema.json",
      "description": "Lists all subscriptions currently known to the service"
    },
    {
      "name": "GetSubscription",
      "type": "Query",
      "protocol": "Http",
      "methodPath": "/subscriptions/{id}",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/get-subscription.schema.json",
      "description": "Returns subscription details and status history for a given subscriptionId"
    },
    {
      "name": "ActivateSubscription",
      "type": "Command",
      "protocol": "Http",
      "methodPath": "/subscriptions/activate",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/activate-subscription.schema.json",
      "description": "Activates a subscription after an order is confirmed (correlates via referenceId)"
    }
  ],
  "events": [
    {
      "type": "subscription-created",
      "version": "1.0",
      "schemaRef": "schemas/events/subscription-created.schema.json",
      "description": "Emitted after a subscription is created; indicates subscription is pending activation"
    },
    {
      "type": "subscription-activated",
      "version": "1.0",
      "schemaRef": "schemas/events/subscription-activated.schema.json",
      "description": "Emitted after a subscription transitions to active (may be disabled in some choreographies)"
    }
  ],
  "consistency": {
    "commands": "ACID",
    "queries": "EVENTUAL"
  },
  "network": {
    "requiredEgress": [
      "localhost:6379"
    ]
  },
  "security": {
    "authentication": {
      "type": "jwt",
      "requiredScopes": [
        "subscriptions.read",
        "subscriptions.write"
      ]
    },
    "dataClassification": [
      "internal"
    ]
  },
  "license": "MIT"
}