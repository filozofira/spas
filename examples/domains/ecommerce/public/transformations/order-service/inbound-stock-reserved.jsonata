/* inbound-stock-reserved.jsonata */
/* Transforms stock-reserved (inventory-service) → order-service format */
/* Source: inventory-service.stock-reserved */
/* Target: order-service StockReservedEvent(OrderId, ReservedItems, ReservedAt) */
{
  "orderId": orderId,
  "reservedItems": $append([], reservations.{
    "productId": productId,
    "quantity": quantity,
    "reservedAt": reservedAt
  }),
  "reservedAt": timestamp
}
