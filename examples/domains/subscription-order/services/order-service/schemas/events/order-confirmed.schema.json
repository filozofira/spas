{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderConfirmedEvent",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "orderId": {
      "type": "string",
      "format": "guid"
    },
    "status": {
      "type": "string"
    },
    "reservedItems": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ReservedItem"
      }
    },
    "shippingAddress": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/Address"
        }
      ]
    },
    "referenceId": {
      "type": [
        "null",
        "string"
      ]
    }
  },
  "definitions": {
    "ReservedItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "productId": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "Address": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "postalCode": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      }
    }
  }
}