### spas.json Generation Pattern

Generate `spas.json` at the workspace root with this structure:

```json
{
  "$schema": "./.spas/schemas/design-time-metadata-v1.schema.json",
  "id": "{NAME}",
  "name": "{Human-Readable Name}",
  "version": "1.0.0",
  "schemaVersion": "1.0",
  "boundedContext": "{CONTEXT}",
  "description": "{Service description from user prompt}",
  "commands": [
    {
      "name": "Create{Entity}",
      "method": "POST",
      "path": "/{entities}",
      "description": "Creates a new {entity}",
      "requestSchema": "schemas/endpoints/create-{entity}-request.json",
      "responseSchema": "schemas/endpoints/create-{entity}-response.json",
      "produces": ["{entity}-created"]
    },
    {
      "name": "Update{Entity}",
      "method": "PUT",
      "path": "/{entities}/{id}",
      "description": "Updates an existing {entity}",
      "requestSchema": "schemas/endpoints/update-{entity}-request.json",
      "responseSchema": "schemas/endpoints/{entity}-response.json",
      "produces": ["{entity}-updated"]
    }
  ],
  "queries": [
    {
      "name": "Get{Entity}",
      "method": "GET",
      "path": "/{entities}/{id}",
      "description": "Gets a single {entity} by ID",
      "responseSchema": "schemas/endpoints/{entity}-response.json"
    },
    {
      "name": "List{Entities}",
      "method": "GET",
      "path": "/{entities}",
      "description": "Lists all {entities}",
      "responseSchema": "schemas/endpoints/{entity}-list-response.json"
    }
  ],
  "events": [
    {
      "name": "{entity}-created",
      "version": "1.0.0",
      "description": "Published when a new {entity} is created",
      "schema": "schemas/events/{entity}-created.json"
    },
    {
      "name": "{entity}-updated",
      "version": "1.0.0",
      "description": "Published when an {entity} is updated",
      "schema": "schemas/events/{entity}-updated.json"
    }
  ],
  "security": {
    "authentication": "none"
  },
  "endpoints": {
    "base": "/"
  }
}
```

**Key Rules**:
- `$schema` must reference `./.spas/schemas/design-time-metadata-v1.schema.json`
- `id` must match the NAME token (kebab-case)
- `commands[].produces[]` must reference event names defined in `events[]`
- `requestSchema` and `responseSchema` paths are relative to workspace root
- Event `schema` paths are relative to workspace root

---

### JSON Schema Generation Patterns

#### Endpoint Request Schema

Generate in `schemas/endpoints/create-{entity}-request.json`:

```json
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "create-{entity}-request.json",
  "title": "Create{Entity}Request",
  "description": "Request payload for creating a new {entity}",
  "type": "object",
  "required": ["customerId", "items"],
  "properties": {
    "customerId": {
      "type": "string",
      "description": "Customer identifier"
    },
    "items": {
      "type": "array",
      "description": "Line items for the {entity}",
      "items": {
        "$ref": "#/$defs/LineItem"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "LineItem": {
      "type": "object",
      "required": ["productId", "quantity"],
      "properties": {
        "productId": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "unitPrice": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
```

#### Endpoint Response Schema

Generate in `schemas/endpoints/{entity}-response.json`:

```json
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "{entity}-response.json",
  "title": "{Entity}Response",
  "description": "Response payload for {entity} operations",
  "type": "object",
  "required": ["id", "customerId", "items", "total", "createdAt"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier"
    },
    "customerId": {
      "type": "string",
      "description": "Customer identifier"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LineItem"
      }
    },
    "total": {
      "type": "number",
      "description": "Total amount"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp"
    }
  },
  "$defs": {
    "LineItem": {
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "quantity": { "type": "integer" },
        "unitPrice": { "type": "number" }
      }
    }
  }
}
```

#### Event Schema

Generate in `schemas/events/{entity}-created.json`:

```json
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "{entity}-created.json",
  "title": "{Entity}CreatedEvent",
  "description": "Event published when a new {entity} is created",
  "type": "object",
  "required": ["id", "customerId", "items", "total", "createdAt"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier of the created {entity}"
    },
    "customerId": {
      "type": "string",
      "description": "Customer who created the {entity}"
    },
    "items": {
      "type": "array",
      "description": "Line items in the {entity}",
      "items": {
        "$ref": "#/$defs/LineItem"
      }
    },
    "total": {
      "type": "number",
      "description": "Total amount of the {entity}"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the {entity} was created"
    }
  },
  "$defs": {
    "LineItem": {
      "type": "object",
      "required": ["productId", "quantity", "unitPrice"],
      "properties": {
        "productId": {
          "type": "string",
          "description": "Product identifier"
        },
        "quantity": {
          "type": "integer",
          "description": "Quantity ordered",
          "minimum": 1
        },
        "unitPrice": {
          "type": "number",
          "description": "Price per unit",
          "minimum": 0
        }
      }
    }
  }
}
```

