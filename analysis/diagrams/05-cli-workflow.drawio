        </mxCell>
        
        <mxCell id="step4" value="4️⃣  Register in Domain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;" vertex="1" parent="1">
          <mxGeometry x="660" y="410" width="250" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="step4_desc" value="$ spas-compose register --domain-file ..." style="text;html=1;fontSize=9;align:center;fontStyle=italic;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="660" y="465" width="250" height="20" as="geometry" />
        </mxCell>
        
        <!-- Arrow down -->
        <mxCell id="arrow8" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="step4_desc" target="step5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="step5" value="5️⃣  Deploy Domain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;" vertex="1" parent="1">
          <mxGeometry x="660" y="510" width="250" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="step5_desc" value="$ spas-compose deploy; docker-compose up" style="text;html=1;fontSize=9;align:center;fontStyle=italic;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="660" y="565" width="250" height="20" as="geometry" />
        </mxCell>
        
        <!-- Legend -->
        <mxCell id="legend_title" value="Notes:" style="text;html=1;fontSize=10;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="100" height="20" as="geometry" />
        </mxCell>
        
        <mxCell id="legend1" value="• spas-service: Single-service CLI (metadata, pack, publish, etc.)" style="text;html=1;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="785" width="500" height="20" as="geometry" />
        </mxCell>
        
        <mxCell id="legend2" value="• spas-compose: Domain-level CLI (init, register, deploy, validate)" style="text;html=1;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="810" width="500" height="20" as="geometry" />
        </mxCell>
        
        <mxCell id="legend3" value="• Repository HTTP API: Stores and retrieves published service archives" style="text;html=1;fontSize=9;align=left;" vertex="1" parent="1">
