{
  "inbound": [
    {
      "kind": "event",
      "topic": "rental-events",
      "invokeEndpoint": "/inventory/reserve",
      "eventType": "com.rental-service.rental-requested",
      "transform": "transformations/inbound-rental-requested.jsonata"
    },
    {
      "kind": "event",
      "topic": "rental-events",
      "invokeEndpoint": "/inventory/release",
      "eventType": "com.rental-service.rental-returned",
      "transform": "transformations/inbound-rental-returned.jsonata"
    },
    {
      "kind": "event",
      "topic": "product-events",
      "invokeEndpoint": "/inventory/items",
      "eventType": "com.product-service.product-added",
      "transform": "transformations/inbound-product-added.jsonata"
    }
  ],
  "outbound": [
    {
      "topic": "inventory-events",
      "eventType": "com.inventory-service.stock-reserved",
      "eventName": "stock-reserved"
    },
    {
      "topic": "inventory-events",
      "eventType": "com.inventory-service.stock-released",
      "eventName": "stock-released"
    },
    {
      "topic": "inventory-events",
      "eventType": "com.inventory-service.inventory-item-added",
      "eventName": "inventory-item-added"
    }
  ]
}