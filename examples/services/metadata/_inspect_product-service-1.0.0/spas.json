{
  "schemaVersion": "design-time-metadata-v1",
  "id": "product-service",
  "name": "product-service",
  "description": "Product catalog browsing service",
  "version": "1.0.0",
  "boundedContext": "product",
  "capabilities": [
    "product-catalog"
  ],
  "endpoints": [
    {
      "name": "ListProducts",
      "type": "Query",
      "protocol": "Http",
      "methodPath": "/products",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/list-products.schema.json",
      "description": "Lists products in the catalog (optionally filtered by category)"
    },
    {
      "name": "GetProduct",
      "type": "Query",
      "protocol": "Http",
      "methodPath": "/products/{id}",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/get-product.schema.json",
      "description": "Returns product details by productId"
    }
  ],
  "events": [],
  "consistency": {
    "commands": "ACID",
    "queries": "EVENTUAL"
  },
  "network": {
    "requiredEgress": []
  },
  "security": {
    "authentication": {
      "type": "jwt",
      "requiredScopes": [
        "products.read"
      ]
    },
    "dataClassification": [
      "public"
    ]
  },
  "license": "MIT"
}