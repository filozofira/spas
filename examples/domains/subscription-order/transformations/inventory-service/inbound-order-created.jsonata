/* inbound-order-created.jsonata */
/* Transforms order-created (order-service) -> reserve-stock (inventory-service) */
/* Source: OrderCreatedEvent { orderId, customerId, items[], total, createdAt, shippingAddress?, referenceId? } */
/* Target: ReserveStockRequest { referenceId, items[] } */
{
  "referenceId": orderId,
  "items": $append([], items.{
    "itemId": productId,
    "quantity": quantity
  })
}
