/* inbound-order-created.jsonata */
/* Transforms order-created event (order-service) → reserve-stock request (inventory-service) */
/* Source: OrderCreatedEvent { orderId, customerId, items: [{productId, quantity, price}], total, createdAt, shippingAddress, referenceId } */
/* Target: ReserveStockRequest { orderId, items: [{productId, quantity}] } */

{
  "orderId": orderId,
  "items": $append([], items.{
    "productId": productId,
    "quantity": quantity
  })
}
