/* inbound-shipment-status-changed.jsonata */
/* Transforms shipment-status-changed (fulfillment-service) → UpdateShipmentStatusRequest (order-service) */
/* Updates order with shipment status changes throughout the fulfillment lifecycle */
{
  "orderId": orderId,
  "shipmentId": shipmentId,
  "status": status,
  "trackingNumber": trackingNumber
}
