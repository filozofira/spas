/* inbound-order-confirmed.jsonata */
/* Transforms order-confirmed (order-service) → create-shipment (fulfillment-service) */
/* Source: schemas/events/order-confirmed.schema.json */
/* Target: schemas/endpoints/create-shipment-request.schema.json */
{
  "referenceId": orderId,
  "customerId": customerId,
  "shippingAddress": {
    "street": shippingAddress.street,
    "city": shippingAddress.city,
    "state": shippingAddress.state,
    "postalCode": shippingAddress.postalCode,
    "country": shippingAddress.country
  },
  "deliveryMethod": $exists(shippingAddress) ? "SHIPPING" : "PICKUP",
  "pickupLocationId": "",
  "specialInstructions": ""
}
