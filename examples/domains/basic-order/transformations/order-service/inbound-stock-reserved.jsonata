/* inbound-stock-reserved.jsonata */
/* Transforms stock-reserved event (inventory-service) → confirm-order request (order-service) */
/* Source: StockReservedEvent { orderId, reservations: [{productId, quantity, reservedAt}], timestamp } */
/* Target: ConfirmOrderRequest { orderId, reservedItems: [{productId, quantity}] } */

{
  "orderId": orderId,
  "reservedItems": $append([], reservations.{
    "productId": productId,
    "quantity": quantity
  })
}
