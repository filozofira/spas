{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "customerId": {
      "type": "string"
    },
    "deliveryMethod": {
      "type": "string"
    },
    "endDate": {
      "type": "string",
      "format": "date-time"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          }
        },
        "required": [
          "productId",
          "quantity"
        ]
      }
    },
    "pickupLocationId": {
      "type": "string"
    },
    "shippingAddress": {
      "type": "object",
      "properties": {
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "postalCode": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "street": {
          "type": "string"
        }
      },
      "required": [
        "city",
        "country",
        "postalCode",
        "state",
        "street"
      ]
    },
    "startDate": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string"
    },
    "statusHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "reason",
          "status",
          "timestamp"
        ]
      }
    }
  },
  "required": [
    "customerId",
    "deliveryMethod",
    "endDate",
    "id",
    "items",
    "pickupLocationId",
    "shippingAddress",
    "startDate",
    "status",
    "statusHistory"
  ]
}