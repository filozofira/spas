  "runtime": {
    "digest": "sha256:133bc66b92a17ea98876c510b25e7f51ff36efa854a5a1ead9cc1489a0754c51",
    "repository": "spas-examples/order-service",
    "tag": "1.0.0",
    "image": "spas-examples/order-service@sha256:133bc66b92a17ea98876c510b25e7f51ff36efa854a5a1ead9cc1489a0754c51"
  }
}