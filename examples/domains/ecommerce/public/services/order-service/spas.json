{
  "schemaVersion": "design-time-metadata-v1",
  "id": "order-service",
  "name": "order-service",
  "description": "Order lifecycle management service",
  "version": "1.0.0",
  "boundedContext": "order",
  "capabilities": [
    "order-management"
  ],
  "endpoints": [
    {
      "name": "CreateOrder",
      "type": "Command",
      "protocol": "Http",
      "methodPath": "/orders",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/create-order.schema.json"
    },
    {
      "name": "ListOrders",
      "type": "Query",
      "protocol": "Http",
      "methodPath": "/orders",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/list-orders.schema.json"
    },
    {
      "name": "GetOrder",
      "type": "Query",
      "protocol": "Http",
      "methodPath": "/orders/{id}",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/get-order.schema.json"
    },
    {
      "name": "ConfirmOrder",
      "type": "Command",
      "protocol": "Http",
      "methodPath": "/orders/confirm",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/confirm-order.schema.json"
    }
  ],
  "events": [
    {
      "type": "order-created",
      "version": "1.0",
      "schemaRef": "schemas/events/order-created.schema.json"
    }
  ],
  "consistency": {
    "commands": "ACID",
    "queries": "EVENTUAL"
  },
  "network": {
    "requiredEgress": [
      "localhost:6379"
    ]
  },
  "security": {
    "authentication": {
      "type": "jwt",
      "requiredScopes": [
        "orders.read",
        "orders.write"
      ]
    },
    "dataClassification": [
      "internal"
    ]
  },
  "license": "MIT",
  "publishedAt": "2025-12-17T21:05:52.988Z",
  "runtime": {
    "digest": "sha256:fc6d849a1aa9862168c191ae10f30a7a5eecfd75fcdb591f9e53854c9bf19fcc",
    "repository": "spas-examples/order-service",
    "tag": "1.0.0",
    "image": "spas-examples/order-service@sha256:fc6d849a1aa9862168c191ae10f30a7a5eecfd75fcdb591f9e53854c9bf19fcc"
  }
}