/* inbound-subscription-created.jsonata */
/* Transforms subscription-created (subscription-service) -> create-order (order-service) */
{
  "customerId": customerId,
  "items": $append([], [{
    "productId": productId,
    "quantity": quantity,
    "price": 0
  }]),
  "total": 0,
  "referenceId": subscriptionId,
  "shippingAddress": {
    "street": "123 Subscription Way",
    "city": "Cloud City",
    "state": "WA",
    "postalCode": "98000",
    "country": "USA"
  }
}
