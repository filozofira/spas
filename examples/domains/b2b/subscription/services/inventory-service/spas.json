{
  "schemaVersion": "design-time-metadata-v1",
  "id": "inventory-service",
  "name": "inventory-service",
  "description": "Stock tracking and reservation service",
  "version": "1.0.0",
  "boundedContext": "inventory",
  "capabilities": [
    "inventory-tracking"
  ],
  "endpoints": [
    {
      "name": "ListInventory",
      "type": "Query",
      "protocol": "Http",
      "methodPath": "/inventory",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/list-inventory.schema.json"
    },
    {
      "name": "GetInventory",
      "type": "Query",
      "protocol": "Http",
      "methodPath": "/inventory/{productId}",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/get-inventory.schema.json"
    },
    {
      "name": "ReserveStock",
      "type": "Command",
      "protocol": "Http",
      "methodPath": "/inventory/reserve",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/reserve-stock.schema.json"
    }
  ],
  "events": [
    {
      "type": "stock-reserved",
      "version": "1.0",
      "schemaRef": "schemas/events/stock-reserved.schema.json"
    },
    {
      "type": "stock-depleted",
      "version": "1.0",
      "schemaRef": "schemas/events/stock-depleted.schema.json"
    }
  ],
  "consistency": {
    "commands": "ACID",
    "queries": "EVENTUAL"
  },
  "network": {
    "requiredEgress": [
      "localhost:6379"
    ]
  },
  "security": {
    "authentication": {
      "type": "jwt",
      "requiredScopes": [
        "inventory.read"
      ]
    },
    "dataClassification": [
      "internal"
    ]
  },
  "license": "MIT",
  "publishedAt": "2025-12-17T22:39:06.816Z",
  "runtime": {
    "digest": "sha256:432416a457a4fba25c1f692f41cc40472fbd5b587bed4963c8d4bb11c93474e3",
    "repository": "spas-examples/inventory-service",
    "tag": "1.0.0",
    "image": "spas-examples/inventory-service@sha256:432416a457a4fba25c1f692f41cc40472fbd5b587bed4963c8d4bb11c93474e3"
  }
}