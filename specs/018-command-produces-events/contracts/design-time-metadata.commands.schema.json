{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spas.io/schemas/design-time-metadata-v1.commands.schema.json",
  "title": "SPAS Design-Time Metadata Commands Extension (PoC)",
  "type": "object",
  "properties": {
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Canonical command identifier (kebab-case)"
          },
          "version": {
            "type": "string",
            "description": "Command contract version (semver recommended)"
          },
          "produces": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "version", "when"],
              "properties": {
                "type": { "type": "string" },
                "version": { "type": "string" },
                "when": { "const": "success" }
              }
            }
          }
        }
      }
    }
  }
}
