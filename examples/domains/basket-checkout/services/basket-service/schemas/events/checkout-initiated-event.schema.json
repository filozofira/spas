{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "basketId": {
      "type": "string"
    },
    "checkoutAt": {
      "type": "string",
      "format": "date-time"
    },
    "customerId": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          }
        },
        "required": [
          "productId",
          "quantity"
        ]
      }
    },
    "shippingAddress": {
      "type": "object",
      "properties": {
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "postalCode": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "street": {
          "type": "string"
        }
      },
      "required": [
        "city",
        "country",
        "postalCode",
        "state",
        "street"
      ]
    }
  },
  "required": [
    "basketId",
    "checkoutAt",
    "customerId",
    "items",
    "shippingAddress"
  ]
}