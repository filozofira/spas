/* inbound-stock-reserved.jsonata */
/* Transforms stock-reserved (inventory-service) → order-service format */
/* Source: inventory-service.stock-reserved */
/* Target: order-service */
{
  "orderId": orderId,
  "reservations": reservations.{
    "productId": productId,
    "quantity": quantity,
    "reservedAt": reservedAt
  },
  "completedAt": timestamp,
  "status": "inventory-reserved"
}
