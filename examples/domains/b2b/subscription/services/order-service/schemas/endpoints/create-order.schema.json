{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateOrderRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "customerId": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/OrderItem"
      }
    },
    "total": {
      "type": "number",
      "format": "decimal"
    }
  },
  "definitions": {
