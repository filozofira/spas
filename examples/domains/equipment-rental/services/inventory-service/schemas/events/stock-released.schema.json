{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StockReleasedEvent",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "referenceId": {
      "type": "string",
      "format": "guid"
    },
    "releases": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/StockReleaseItem"
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "definitions": {
    "StockReleaseItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "productId": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "int32"
        },
        "releasedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "productId",
        "quantity",
        "releasedAt"
      ]
    }
  },
  "required": [
    "referenceId",
    "releases",
    "timestamp"
  ]
}