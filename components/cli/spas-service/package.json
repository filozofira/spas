{
  "name": "@spas/cli",
  "version": "0.1.0",
  "description": "SPAS Service CLI - Command-line tool for publishing and managing SPAS service metadata",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "spas-service": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc && npm run copy:templates",
    "copy:templates": "node -e \"const fs = require('fs'); fs.cpSync('templates', 'dist/templates', { recursive: true });\"",
    "watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "spas",
    "cli",
    "metadata",
    "service-architecture"
  ],
  "author": "SPAS Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "axios": "^1.6.2",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "eta": "^3.5.0",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
