/* inbound-order-created.jsonata */
/* Transforms order-created (order-service) → ReserveStockRequest (inventory-service) */
/* Source: OrderCreatedEvent { orderId, customerId, items: [{ productId, quantity, price }], total, createdAt } */
/* Target: ReserveStockRequest { orderId, items: [{ productId, quantity }] } */
{
  "orderId": orderId,
  "items": $append([], items.{
    "productId": productId,
    "quantity": quantity
  })
}
