/* inbound-stock-reserved.jsonata */
/* Transforms stock-reserved (inventory-service) -> confirm-order request (order-service) */
/* Source: schemas/events/stock-reserved.schema.json */
/* Target: schemas/endpoints/confirm-order.schema.json */

{
  "orderId": referenceId,
  "reservedItems": $append([], reservations.{
    "productId": itemId,
    "quantity": quantity
  })
}
