{
  "schemaVersion": "runtime-metadata-v1",
  "id": "inventory-service",
  "name": "inventory-service",
  "description": "Stock tracking and reservation service",
  "version": "1.0.0",
  "boundedContext": "inventory",
  "capabilities": [
    "inventory-tracking"
  ],
  "endpoints": [
    {
      "name": "list-inventory",
      "type": "Query",
      "protocol": "Http",
      "methodPath": "/inventory",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/list-inventory.schema.json",
      "description": "Lists current inventory levels for all products"
    },
    {
      "name": "get-inventory",
      "type": "Query",
      "protocol": "Http",
      "methodPath": "/inventory/{productId}",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/get-inventory.schema.json",
      "description": "Returns available/reserved quantity for a specific productId"
    },
    {
      "name": "reserve-stock",
      "type": "Command",
      "protocol": "Http",
      "methodPath": "/inventory/reserve",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/reserve-stock.schema.json",
      "description": "Reserves stock for an order and publishes StockReserved for successfully reserved items"
    }
  ],
  "commands": [
    {
      "name": "reserve-stock",
      "version": "1.0",
      "produces": [
        {
          "type": "stock-reserved",
          "version": "1.0",
          "when": "success"
        }
      ]
    }
  ],
  "events": [
    {
      "type": "stock-reserved",
      "version": "1.0",
      "schemaRef": "schemas/events/stock-reserved.schema.json",
      "description": "Emitted when stock is successfully reserved for one or more items in an order"
    },
    {
      "type": "stock-depleted",
      "version": "1.0",
      "schemaRef": "schemas/events/stock-depleted.schema.json",
      "description": "Emitted when requested quantity exceeds available inventory for a product"
    }
  ],
  "consistency": {
    "commands": "ACID",
    "queries": "EVENTUAL"
  },
  "network": {
    "requiredEgress": [
      "localhost:6379"
    ]
  },
  "security": {
    "authentication": {
      "type": "jwt",
      "requiredScopes": [
        "inventory.read"
      ]
    },
    "dataClassification": [
      "internal"
    ]
  },
  "license": "MIT",
  "publishedAt": "2025-12-22T09:46:51.228Z",
  "runtime": {
    "digest": "sha256:b2216d668e9130721dd0ab291e97a39f3de4b56e7b3451895e2422642dd80d33",
    "repository": "spas-examples/inventory-service",
    "tag": "1.0.0",
    "image": "spas-examples/inventory-service@sha256:b2216d668e9130721dd0ab291e97a39f3de4b56e7b3451895e2422642dd80d33"
  }
}