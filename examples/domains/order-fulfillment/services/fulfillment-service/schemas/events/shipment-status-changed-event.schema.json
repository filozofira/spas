{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "referenceId": {
      "type": "string"
    },
    "shipmentId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "PROCESSING",
        "SHIPPED",
        "IN_TRANSIT",
        "DELIVERED",
        "CANCELLED"
      ]
    },
    "trackingNumber": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "referenceId",
    "shipmentId",
    "status",
    "trackingNumber",
    "updatedAt"
  ]
}