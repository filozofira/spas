/* inbound-shipment-created.jsonata */
/* Transforms shipment-created (fulfillment-service) -> update-shipment-status (order-service) */
/* Source: schemas/events/shipment-created-event.schema.json */
/* Target: schemas/endpoints/update-shipment-status.schema.json */
{
  "orderId": referenceId,
  "shipmentId": shipmentId,
  "status": status,
  "trackingNumber": null
}
