{
  "schemaVersion": "runtime-metadata-v1",
  "id": "inventory-service",
  "name": "inventory-service",
  "description": "Item quantity tracking and reservation service",
  "version": "1.0.0",
  "boundedContext": "inventory",
  "capabilities": [
    "inventory-tracking"
  ],
  "endpoints": [
    {
      "name": "list-inventory",
      "type": "Query",
      "protocol": "Http",
      "methodPath": "/inventory",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/list-inventory.schema.json",
      "description": "Lists current inventory levels for all items"
    },
    {
      "name": "get-inventory",
      "type": "Query",
      "protocol": "Http",
      "methodPath": "/inventory/{itemId}",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/get-inventory.schema.json",
      "description": "Returns available/reserved quantity for a specific itemId"
    },
    {
      "name": "add-inventory-item",
      "type": "Command",
      "protocol": "Http",
      "methodPath": "/inventory/items",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/add-inventory-item.schema.json",
      "description": "Initializes inventory tracking for a new item"
    },
    {
      "name": "reserve-stock",
      "type": "Command",
      "protocol": "Http",
      "methodPath": "/inventory/reserve",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/reserve-stock.schema.json",
      "description": "Reserves item quantities for a reference and publishes relevant events for successfully reserved items"
    },
    {
      "name": "release-stock",
      "type": "Command",
      "protocol": "Http",
      "methodPath": "/inventory/release",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/release-stock.schema.json",
      "description": "Releases reserved item quantities back to available inventory"
    }
  ],
  "commands": [
    {
      "name": "add-inventory-item",
      "version": "1.0",
      "produces": [
        {
          "type": "inventory-item-added",
          "version": "1.0",
          "when": "success"
        }
      ]
    },
    {
      "name": "reserve-stock",
      "version": "1.0",
      "produces": [
        {
          "type": "stock-reserved",
          "version": "1.0",
          "when": "success"
        },
        {
          "type": "stock-depleted",
          "version": "1.0",
          "when": "success"
        }
      ]
    },
    {
      "name": "release-stock",
      "version": "1.0",
      "produces": [
        {
          "type": "stock-released",
          "version": "1.0",
          "when": "success"
        }
      ]
    }
  ],
  "events": [
    {
      "type": "inventory-item-added",
      "version": "1.0",
      "schemaRef": "schemas/events/inventory-item-added.schema.json",
      "description": "Emitted when inventory tracking is initialized for a new item"
    },
    {
      "type": "stock-depleted",
      "version": "1.0",
      "schemaRef": "schemas/events/stock-depleted.schema.json",
      "description": "Emitted when requested quantity exceeds available inventory for an item"
    },
    {
      "type": "stock-released",
      "version": "1.0",
      "schemaRef": "schemas/events/stock-released.schema.json",
      "description": "Emitted when reserved item quantities are released back to available inventory"
    },
    {
      "type": "stock-reserved",
      "version": "1.0",
      "schemaRef": "schemas/events/stock-reserved.schema.json",
      "description": "Emitted when item quantities are successfully reserved against a reference (order, rental, subscription, etc.)"
    }
  ],
  "consistency": {
    "commands": "ACID",
    "queries": "EVENTUAL"
  },
  "network": {
    "requiredEgress": [
      "localhost:6379"
    ]
  },
  "security": {
    "authentication": {
      "type": "jwt",
      "requiredScopes": [
        "inventory.read"
      ]
    },
    "dataClassification": [
      "internal"
    ]
  },
  "license": "MIT",
  "publishedAt": "2026-01-04T13:38:46.633Z",
  "runtime": {
    "digest": "sha256:TODO_UPDATE_AFTER_BUILD",
    "repository": "spas-examples/inventory-service",
    "tag": "1.0.0",
    "image": "spas-examples/inventory-service@sha256:TODO_UPDATE_AFTER_BUILD"
  }
}