## SDK Integration Patterns

This section provides idiomatic code patterns for integrating with the SPAS SDK.
Use the patterns matching the STACK token (java or dotnet).

---

### Java/Spring Patterns

#### Project Structure (Maven)

```
{NAME}/
├── pom.xml
├── src/
│   ├── main/
│   │   ├── java/com/{context}/{name}/
│   │   │   ├── Application.java
│   │   │   ├── config/
│   │   │   │   └── SpasConfig.java
│   │   │   ├── controller/
│   │   │   │   └── {Entity}Controller.java
│   │   │   ├── service/
│   │   │   │   └── {Entity}Service.java
│   │   │   ├── model/
│   │   │   │   ├── {Entity}.java
│   │   │   │   ├── Create{Entity}Request.java
│   │   │   │   └── {Entity}Response.java
│   │   │   ├── repository/
│   │   │   │   ├── {Entity}Repository.java
│   │   │   │   └── InMemory{Entity}Repository.java
│   │   │   └── events/
│   │   │       └── {Entity}CreatedEvent.java
│   │   └── resources/
│   │       └── application.yaml
│   └── test/
│       └── java/com/{context}/{name}/
│           └── {Entity}ServiceTest.java
├── spas.json
├── schemas/
│   ├── endpoints/
│   │   ├── create-{entity}-request.json
│   │   └── create-{entity}-response.json
│   └── events/
│       └── {entity}-created.json
└── metadata/
```

#### pom.xml Template

```xml
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>
    
    <groupId>com.{context}</groupId>
    <artifactId>{name}</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    
    <properties>
        <!-- Use your installed JDK version (17 minimum, 21+ recommended) -->
        <java.version>21</java.version>
        <spas-sdk.version>1.0.0-SNAPSHOT</spas-sdk.version>
    </properties>
    
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        
        <!-- SPAS SDK (groupId must be io.spas, NOT com.spas) -->
        <dependency>
            <groupId>io.spas</groupId>
            <artifactId>spas-sdk-spring</artifactId>
            <version>${spas-sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>io.spas</groupId>
            <artifactId>spas-sdk-events</artifactId>
            <version>${spas-sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>io.spas</groupId>
            <artifactId>spas-sdk-metadata</artifactId>
            <version>${spas-sdk.version}</version>
        </dependency>
        
        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
```

#### Application Entry Point

```java
package com.{context}.{name};

import io.spas.sdk.metadata.annotations.SpasService;
import io.spas.sdk.metadata.model.Authentication;
import io.spas.sdk.metadata.model.AuthType;
import io.spas.sdk.metadata.model.Consistency;
import io.spas.sdk.metadata.model.ConsistencyLevel;
import io.spas.sdk.metadata.model.DataClassification;
import io.spas.sdk.metadata.model.Network;
import io.spas.sdk.metadata.model.QueryConsistencyLevel;
import io.spas.sdk.metadata.model.Security;
import io.spas.sdk.spring.SpasServiceRunner;
import org.springframework.boot.autoconfigure.SpringBootApplication;

import java.util.List;

/**
 * {Human-Readable Name} - A SPAS-compliant service.
 */
@SpringBootApplication
@SpasService(
    id = "{name}",
    name = "{Human-Readable Name}",
    boundedContext = "{context}",
    version = "1.0.0",
    description = "{Service description}"
)
public class Application {
    public static void main(String[] args) {
        SpasServiceRunner.run(Application.class, args, options -> {
            options.setConsistency(new Consistency(ConsistencyLevel.ACID, QueryConsistencyLevel.EVENTUAL));
            options.setNetwork(new Network(List.of("localhost:5432")));
            options.setSecurity(new Security(
                new Authentication(AuthType.JWT, List.of("{entity}.read", "{entity}.write")),
                List.of(DataClassification.INTERNAL)
            ));
            options.setLicense("MIT");
        });
    }
}
```

#### SPAS Configuration

```java
package com.{context}.{name}.config;

import io.spas.sdk.core.config.SpasConfiguration;
import io.spas.sdk.events.EventPublisher;
import io.spas.sdk.events.EventPublisherConfig;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

import java.time.Duration;

@Configuration
public class SpasConfig {
    
    @Bean
    public EventPublisher eventPublisher() {
        SpasConfiguration spasConfig = new SpasConfiguration();
        EventPublisherConfig config = EventPublisherConfig.builder()
            .sidecarUrl(spasConfig.getSidecarUrl().toString())
            .timeout(Duration.ofSeconds(5))
            .build();
        return new EventPublisher(config, spasConfig.getServiceName());
    }
}
```

#### Event Class with @SpasEvent Annotation

```java
package com.{context}.{name}.event;

import io.spas.sdk.metadata.annotations.SpasEvent;
import java.math.BigDecimal;
import java.time.Instant;
import java.util.List;

/**
 * Event published when a new {entity} is created.
 * 
 * CloudEvents type: com.{context}.{entity}-created
 */
@SpasEvent(type = "{Entity}Created", version = "1.0.0", description = "Emitted when a {entity} is created")
public record {Entity}CreatedEvent(
    String id,
    String customerId,
    List<LineItem> items,
    BigDecimal total,
    Instant createdAt
) {
    public record LineItem(
        String productId,
        int quantity,
        BigDecimal unitPrice
    ) {}
}
```

#### Controller with Command Handler

```java
package com.{context}.{name}.controller;

import com.{context}.{name}.model.*;
import com.{context}.{name}.service.{Entity}Service;
import jakarta.validation.Valid;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

@RestController
@RequestMapping("/{entities}")
public class {Entity}Controller {
    
    private final {Entity}Service service;
    
    public {Entity}Controller({Entity}Service service) {
        this.service = service;
    }
    
    /**
     * Command: Create{Entity}
     * Produces: {entity}-created event
     */
    @PostMapping
    public ResponseEntity<{Entity}Response> create(
            @Valid @RequestBody Create{Entity}Request request) {
        {Entity} entity = service.create(request);
        return ResponseEntity
            .status(HttpStatus.CREATED)
            .body({Entity}Response.from(entity));
    }
    
    /**
     * Query: Get{Entity}
     */
    @GetMapping("/{id}")
    public ResponseEntity<{Entity}Response> getById(@PathVariable String id) {
        return service.findById(id)
            .map(entity -> ResponseEntity.ok({Entity}Response.from(entity)))
            .orElse(ResponseEntity.notFound().build());
    }
    
    /**
     * Query: List{Entities}
     */
    @GetMapping
    public ResponseEntity<List<{Entity}Response>> list() {
        List<{Entity}Response> responses = service.findAll().stream()
            .map({Entity}Response::from)
            .toList();
        return ResponseEntity.ok(responses);
    }
}
```

#### Service with Event Publishing

```java
package com.{context}.{name}.service;

import com.{context}.{name}.event.{Entity}CreatedEvent;
import com.{context}.{name}.model.*;
import com.{context}.{name}.repository.{Entity}Repository;
import io.spas.sdk.events.EventPublisher;
import org.springframework.stereotype.Service;
import java.time.Instant;
import java.util.List;
import java.util.Optional;
import java.util.UUID;

@Service
public class {Entity}Service {
    
    private final {Entity}Repository repository;
    private final EventPublisher eventPublisher;
    
    public {Entity}Service(
            {Entity}Repository repository,
            EventPublisher eventPublisher) {
        this.repository = repository;
        this.eventPublisher = eventPublisher;
    }
    
    /**
     * Creates a new {entity} and publishes {entity}-created event.
     */
    public {Entity} create(Create{Entity}Request request) {
        // Create entity
        {Entity} entity = new {Entity}(
            UUID.randomUUID().toString(),
            request.customerId(),
            request.items(),
            request.calculateTotal(),
            Instant.now()
        );
        
        // Persist
        {Entity} saved = repository.save(entity);
        
        // Publish event to sidecar
        eventPublisher.publish(new {Entity}CreatedEvent(
            saved.id(),
            saved.customerId(),
            saved.items().stream()
                .map(i -> new {Entity}CreatedEvent.LineItem(
                    i.productId(), i.quantity(), i.unitPrice()))
                .toList(),
            saved.total(),
            saved.createdAt()
        ));
        
        return saved;
    }
    
    public Optional<{Entity}> findById(String id) {
        return repository.findById(id);
    }
    
    public List<{Entity}> findAll() {
        return repository.findAll();
    }
}
```

#### Repository Interface

```java
package com.{context}.{name}.repository;

import com.{context}.{name}.model.{Entity};
import java.util.List;
import java.util.Optional;

public interface {Entity}Repository {
    {Entity} save({Entity} entity);
    Optional<{Entity}> findById(String id);
    List<{Entity}> findAll();
    void deleteById(String id);
}
```

#### In-Memory Repository Implementation

```java
package com.{context}.{name}.repository;

import com.{context}.{name}.model.{Entity};
import org.springframework.stereotype.Repository;
import java.util.*;
import java.util.concurrent.ConcurrentHashMap;

@Repository
public class InMemory{Entity}Repository implements {Entity}Repository {
    
    private final Map<String, {Entity}> store = new ConcurrentHashMap<>();
    
    @Override
    public {Entity} save({Entity} entity) {
        store.put(entity.id(), entity);
        return entity;
    }
    
    @Override
    public Optional<{Entity}> findById(String id) {
        return Optional.ofNullable(store.get(id));
    }
    
    @Override
    public List<{Entity}> findAll() {
        return new ArrayList<>(store.values());
    }
    
    @Override
    public void deleteById(String id) {
        store.remove(id);
    }
}
```

#### application.yaml

```yaml
server:
  port: 8080

spring:
  application:
    name: {name}

spas:
  service:
    id: {name}
  sidecar:
    url: ${SPAS_SIDECAR_URL:http://localhost:3001}

management:
  endpoints:
    web:
      exposure:
        include: health,info
  endpoint:
    health:
      show-details: always
```

