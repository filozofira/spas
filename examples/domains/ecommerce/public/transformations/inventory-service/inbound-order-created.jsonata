/* inbound-order-created.jsonata */
/* Transforms order-created (order-service) → inventory-service format */
/* Source: order-service.order-created */
/* Target: inventory-service */
{
  "orderId": orderId,
  "items": items.{
    "productId": productId,
    "quantity": quantity
  },
  "requestedAt": createdAt
}
