{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StockReservedEvent",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "referenceId": {
      "type": "string",
      "format": "guid"
    },
    "reservations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/StockReservation"
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "definitions": {
    "StockReservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "productId": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "int32"
        },
        "reservedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "productId",
        "quantity",
        "reservedAt"
      ]
    }
  },
  "required": [
    "referenceId",
    "reservations",
    "timestamp"
  ]
}