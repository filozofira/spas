/* inbound-subscription-created.jsonata */
/* Transforms subscription-created (subscription-service) → CreateOrderRequest (order-service) */
/* Correlation: subscriptionId → referenceId */
{
  "customerId": customerId,
  "items": $append([], {
    "productId": productId,
    "quantity": quantity,
    "price": 0
  }),
  "total": 0,
  "referenceId": $string(subscriptionId)
}
