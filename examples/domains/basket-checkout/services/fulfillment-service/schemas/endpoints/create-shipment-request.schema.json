{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "customerId": {
      "type": "string"
    },
    "deliveryMethod": {
      "type": "string"
    },
    "pickupLocationId": {
      "type": "string"
    },
    "referenceId": {
      "type": "string"
    },
    "shippingAddress": {
      "type": "object",
      "properties": {
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "postalCode": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "street": {
          "type": "string"
        }
      },
      "required": [
        "city",
        "country",
        "postalCode",
        "state",
        "street"
      ]
    },
    "specialInstructions": {
      "type": "string"
    }
  },
  "required": [
    "customerId",
    "deliveryMethod",
    "pickupLocationId",
    "referenceId",
    "shippingAddress",
    "specialInstructions"
  ]
}