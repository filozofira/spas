{
  "schemaVersion": "runtime-metadata-v1",
  "id": "product-service",
  "name": "product-service",
  "description": "Product catalog browsing service",
  "version": "1.0.0",
  "boundedContext": "product",
  "capabilities": [
    "product-catalog"
  ],
  "endpoints": [
    {
      "name": "list-products",
      "type": "Query",
      "protocol": "Http",
      "methodPath": "/products",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/list-products.schema.json",
      "description": "Lists products in the catalog (optionally filtered by category)"
    },
    {
      "name": "get-product",
      "type": "Query",
      "protocol": "Http",
      "methodPath": "/products/{id}",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/get-product.schema.json",
      "description": "Returns product details by productId"
    },
    {
      "name": "add-product",
      "type": "Command",
      "protocol": "Http",
      "methodPath": "/products",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/add-product.schema.json",
      "description": "Adds a new product to the catalog"
    },
    {
      "name": "update-product",
      "type": "Command",
      "protocol": "Http",
      "methodPath": "/products/{id}",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/update-product.schema.json",
      "description": "Updates an existing product with partial field updates"
    },
    {
      "name": "remove-product",
      "type": "Command",
      "protocol": "Http",
      "methodPath": "/products/{id}",
      "version": "1.0",
      "schemaRef": "schemas/endpoints/remove-product.schema.json",
      "description": "Removes a product from the catalog"
    }
  ],
  "commands": [
    {
      "name": "add-product",
      "version": "1.0",
      "produces": [
        {
          "type": "product-added",
          "version": "1.0",
          "when": "success"
        }
      ]
    },
    {
      "name": "update-product",
      "version": "1.0",
      "produces": [
        {
          "type": "product-updated",
          "version": "1.0",
          "when": "success"
        }
      ]
    },
    {
      "name": "remove-product",
      "version": "1.0",
      "produces": [
        {
          "type": "product-removed",
          "version": "1.0",
          "when": "success"
        }
      ]
    }
  ],
  "events": [
    {
      "type": "product-added",
      "version": "1.0",
      "schemaRef": "schemas/events/product-added.schema.json",
      "description": "Emitted when a new product is added to the catalog"
    },
    {
      "type": "product-removed",
      "version": "1.0",
      "schemaRef": "schemas/events/product-removed.schema.json",
      "description": "Emitted when a product is removed from the catalog"
    },
    {
      "type": "product-updated",
      "version": "1.0",
      "schemaRef": "schemas/events/product-updated.schema.json",
      "description": "Emitted when a product is updated with the full current state"
    }
  ],
  "consistency": {
    "commands": "ACID",
    "queries": "EVENTUAL"
  },
  "network": {
    "requiredEgress": [
      "localhost:6379"
    ]
  },
  "security": {
    "authentication": {
      "type": "jwt",
      "requiredScopes": [
        "products.read",
        "products.write"
      ]
    },
    "dataClassification": [
      "internal"
    ]
  },
  "license": "MIT",
  "publishedAt": "2026-01-04T13:38:46.832Z",
  "runtime": {
    "digest": "sha256:TODO_UPDATE_AFTER_BUILD",
    "repository": "spas-examples/product-service",
    "tag": "1.0.0",
    "image": "spas-examples/product-service@sha256:TODO_UPDATE_AFTER_BUILD"
  }
}