/* inbound-subscription-created.jsonata */
/* Transforms subscription-created (subscription-service) -> create-order (order-service) */
/* Source: SubscriptionCreatedEvent { subscriptionId, customerId, productId, quantity, frequency, createdAt } */
/* Target: CreateOrderRequest { customerId, items[], total, shippingAddress?, referenceId? } */
{
  "customerId": customerId,
  "items": $append([], {
    "productId": productId,
    "quantity": quantity,
    "price": 0
  }),
  "total": 0,
  "referenceId": subscriptionId
}
