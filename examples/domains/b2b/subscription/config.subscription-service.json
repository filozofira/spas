{
  "inbound": [
    {
      "kind": "command",
      "command": "CreateSubscription",
      "invokeEndpoint": "/subscriptions"
    },
    {
      "kind": "event",
      "topic": "order-events",
      "eventType": "com.order-service.order-confirmed",
      "invokeEndpoint": "/subscriptions/activate",
      "transform": "transformations/inbound-order-confirmed.jsonata"
    }
  ],
  "outbound": [
    {
      "topic": "subscription-events",
      "eventType": "com.subscription-service.subscription-created",
      "eventName": "subscription-created"
    },
    {
      "topic": "subscription-events",
      "eventType": "com.subscription-service.subscription-activated",
      "eventName": "subscription-activated"
    }
  ]
}