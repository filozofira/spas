{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SubscriptionActivatedEvent",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "subscriptionId": {
      "type": "string",
      "format": "guid"
    },
    "orderId": {
      "type": "string",
      "format": "guid"
    },
    "customerId": {
      "type": "string"
    },
    "productId": {
      "type": "string"
    },
    "quantity": {
      "type": "integer",
      "format": "int32"
    },
    "frequency": {
      "type": "string"
    },
    "activatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}