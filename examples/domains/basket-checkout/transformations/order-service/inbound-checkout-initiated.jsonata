/* inbound-checkout-initiated.jsonata */
/* Transforms checkout-initiated (basket-service) → create-order (order-service) */
/* Source: schemas/events/checkout-initiated-event.schema.json */
/* Target: schemas/endpoints/create-order.schema.json */
{
  "customerId": customerId,
  "items": $append([], items.{
    "productId": productId,
    "quantity": quantity,
    "price": 0.0
  }),
  "total": 0.0,
  "shippingAddress": {
    "street": shippingAddress.street,
    "city": shippingAddress.city,
    "state": shippingAddress.state,
    "postalCode": shippingAddress.postalCode,
    "country": shippingAddress.country
  },
  "referenceId": basketId
}
