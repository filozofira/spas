/* inbound-order-created.jsonata */
/* Transforms order-created (order-service) -> reserve-stock (inventory-service) */
/* Source schema: services/order-service/schemas/events/order-created.schema.json */
/* Target schema: services/inventory-service/schemas/endpoints/reserve-stock.schema.json */

{
  "referenceId": orderId,
  "items": $append([], items.{
    "itemId": productId,
    "quantity": quantity
  })
}
