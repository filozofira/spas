<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" modified="2025-12-05" agent="5.0" version="24.0.0" type="device">
  <diagram name="CLI Workflow" id="cli1">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Title -->
        <mxCell id="title" value="CLI Workflow: spas-service and spas-compose" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="600" height="30" as="geometry" />
        </mxCell>
        
        <!-- Left Column: spas-service -->
        <mxCell id="cli1_header" value="spas-service (Service-Level)" style="text;html=1;fontSize=12;fontStyle=1;align=center;fillColor=#E3F2FD;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="250" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="cmd1" value="📍 spas-service metadata get" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="250" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="cmd1_desc" value="Retrieves service metadata from /_spas/metadata endpoint" style="text;html=1;fontSize=9;align=center;fontStyle=italic;" vertex="1" parent="1">
          <mxGeometry x="40" y="165" width="250" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="cmd1_output" value="Output: &#xa;{&#xa;  serviceName, version,&#xa;  events: {published, subscribed},&#xa;  schemas, transformations&#xa;}" style="text;html=1;fontSize=8;align=left;fillColor=#F5F5F5;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="250" height="80" as="geometry" />
        </mxCell>
        
        <!-- Arrow down -->
        <mxCell id="arrow1" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="cmd1_output" target="cmd2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="cmd2" value="📍 spas-service pack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="250" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="cmd2_desc" value="Bundles service into versioned archive (.zip or .tar.gz)" style="text;html=1;fontSize=9;align=center;fontStyle=italic;" vertex="1" parent="1">
          <mxGeometry x="40" y="365" width="250" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="cmd2_output" value="$ spas-service pack&#xa;  --name order-service&#xa;  --version 1.0.0&#xa;  --output ./archive/&#xa;  [--format tar.gz]&#xa;&#xa;Created: order-service-1.0.0.zip" style="text;html=1;fontSize=8;align=left;fillColor=#F5F5F5;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="250" height="90" as="geometry" />
        </mxCell>
        
        <!-- Arrow down -->
        <mxCell id="arrow2" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="cmd2_output" target="cmd3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="cmd3" value="📍 spas-service publish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="250" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="cmd3_desc" value="Pushes archived service to Repository (HTTP POST)" style="text;html=1;fontSize=9;align=center;fontStyle=italic;" vertex="1" parent="1">
          <mxGeometry x="40" y="585" width="250" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="cmd3_output" value="$ spas-service publish&#xa;  --repository http://repo:4000&#xa;  --archive ./archive/order-service-1.0.0.zip&#xa;  [--metadata-override metadata.json]&#xa;&#xa;Published: order-service@1.0.0" style="text;html=1;fontSize=8;align=left;fillColor=#F5F5F5;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="250" height="90" as="geometry" />
        </mxCell>
        
        <!-- Right Column: spas-compose -->
        <mxCell id="cli2_header" value="spas-compose (Domain-Level)" style="text;html=1;fontSize=12;fontStyle=1;align=center;fillColor=#F3E5F5;" vertex="1" parent="1">
          <mxGeometry x="350" y="60" width="250" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="compose1" value="📍 spas-compose init" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;" vertex="1" parent="1">
          <mxGeometry x="350" y="110" width="250" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="compose1_desc" value="Creates new domain.yaml template with scaffolding" style="text;html=1;fontSize=9;align=center;fontStyle=italic;" vertex="1" parent="1">
          <mxGeometry x="350" y="165" width="250" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="compose1_output" value="$ spas-compose init&#xa;  --domain my-ecommerce-domain&#xa;  --output ./domain/&#xa;&#xa;Created: domain.yaml, transformations/, services/" style="text;html=1;fontSize=8;align=left;fillColor=#F5F5F5;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="350" y="200" width="250" height="80" as="geometry" />
        </mxCell>
        
        <!-- Arrow down -->
        <mxCell id="arrow3" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="compose1_output" target="compose2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="compose2" value="📍 spas-compose register" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;" vertex="1" parent="1">
          <mxGeometry x="350" y="310" width="250" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="compose2_desc" value="Registers services with domain; validates event choreography" style="text;html=1;fontSize=9;align=center;fontStyle=italic;" vertex="1" parent="1">
          <mxGeometry x="350" y="365" width="250" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="compose2_output" value="$ spas-compose register&#xa;  --domain-file domain.yaml&#xa;  --service-path services/&#xa;  --repository http://repo:4000&#xa;&#xa;Registered: 3 services; validated choreography" style="text;html=1;fontSize=8;align=left;fillColor=#F5F5F5;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="350" y="400" width="250" height="90" as="geometry" />
        </mxCell>
        
        <!-- Arrow down -->
        <mxCell id="arrow4" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="compose2_output" target="compose3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="compose3" value="📍 spas-compose deploy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;" vertex="1" parent="1">
          <mxGeometry x="350" y="530" width="250" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="compose3_desc" value="Generates docker-compose.yml and deployment config" style="text;html=1;fontSize=9;align=center;fontStyle=italic;" vertex="1" parent="1">
          <mxGeometry x="350" y="585" width="250" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="compose3_output" value="$ spas-compose deploy&#xa;  --domain-file domain.yaml&#xa;  --output ./deploy/&#xa;  [--format docker-compose]&#xa;&#xa;Generated: docker-compose.yml, .env" style="text;html=1;fontSize=8;align=left;fillColor=#F5F5F5;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="350" y="620" width="250" height="90" as="geometry" />
        </mxCell>
        
        <!-- Right Column: Developer Workflow -->
        <mxCell id="workflow_header" value="Typical Developer Workflow" style="text;html=1;fontSize=12;fontStyle=1;align=center;fillColor=#E8F5E9;" vertex="1" parent="1">
          <mxGeometry x="660" y="60" width="250" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="step1" value="1️⃣  Develop Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;" vertex="1" parent="1">
          <mxGeometry x="660" y="110" width="250" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="step1_desc" value="Write spas.yaml, schemas/, HTTP handlers" style="text;html=1;fontSize=9;align=center;fontStyle=italic;" vertex="1" parent="1">
          <mxGeometry x="660" y="165" width="250" height="20" as="geometry" />
        </mxCell>
        
        <!-- Arrow down -->
        <mxCell id="arrow5" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="step1_desc" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="step2" value="2️⃣  Pack Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;" vertex="1" parent="1">
          <mxGeometry x="660" y="210" width="250" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="step2_desc" value="$ spas-service pack --name ... --version ..." style="text;html=1;fontSize=9;align=center;fontStyle=italic;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="660" y="265" width="250" height="20" as="geometry" />
        </mxCell>
        
        <!-- Arrow down -->
        <mxCell id="arrow6" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="step2_desc" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="step3" value="3️⃣  Publish to Repository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;" vertex="1" parent="1">
          <mxGeometry x="660" y="310" width="250" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="step3_desc" value="$ spas-service publish --repository ..." style="text;html=1;fontSize=9;align=center;fontStyle=italic;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="660" y="365" width="250" height="20" as="geometry" />
        </mxCell>
        
        <!-- Arrow down -->
        <mxCell id="arrow7" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="step3_desc" target="step4">
