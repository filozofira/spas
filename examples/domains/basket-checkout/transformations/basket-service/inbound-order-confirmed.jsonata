/* inbound-order-confirmed.jsonata */
/* Transforms order-confirmed (order-service) -> clear-basket (basket-service) */
/* Source: schemas/events/order-confirmed.schema.json */
/* Target: schemas/endpoints/order-created-payload.schema.json */
{
  "orderId": orderId,
  "customerId": customerId,
  "referenceId": referenceId,
  "createdAt": $now()
}
