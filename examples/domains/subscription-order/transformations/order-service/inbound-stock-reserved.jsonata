/* inbound-stock-reserved.jsonata */
/* Transforms stock-reserved (inventory-service) -> confirm-order (order-service) */
/* Source: StockReservedEvent { referenceId, reservations[], timestamp } */
/* Target: ConfirmOrderRequest { orderId, reservedItems[] } */
{
  "orderId": referenceId,
  "reservedItems": $append([], reservations.{
    "productId": itemId,
    "quantity": quantity
  })
}
