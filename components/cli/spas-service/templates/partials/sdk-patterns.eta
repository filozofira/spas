### .NET Patterns (Minimal APIs Only)

> **Note:** The .NET SDK only supports minimal API endpoints (`app.MapPost`, `app.MapGet`, etc.). 
> Controller-based routing is not supported for metadata discovery.

#### Project Structure

```
{NAME}/
├── {Name}.csproj
├── Program.cs
├── appsettings.json
├── Dockerfile
├── DTOs/
│   ├── Create{Entity}Request.cs
│   └── Create{Entity}Response.cs
├── Models/
│   └── {Entity}.cs
├── Services/
│   └── {Entity}Store.cs
├── Events/
│   └── {Entity}CreatedEvent.cs
├── metadata/
│   └── service.metadata.zip
└── README.md
```

#### .csproj Template

```xml
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spas.Sdk.Core" Version="1.0.0-*" />
    <PackageReference Include="Spas.Sdk.Metadata" Version="1.0.0-*" />
    <PackageReference Include="Spas.Sdk.Events" Version="1.0.0-*" />
    <PackageReference Include="Spas.Sdk.Observability" Version="1.0.0-*" />
  </ItemGroup>

</Project>
```

#### Program.cs with Inline Endpoints (Minimal APIs)

```csharp
using {Name}.DTOs;
using {Name}.Models;
using {Name}.Events;
using {Name}.Services;
using Spas.Sdk.Metadata.Attributes;
using Spas.Sdk.Metadata.Extensions;
using Spas.Sdk.Events.Publish;

var builder = WebApplication.CreateBuilder(args);

// Add services to the container
builder.Services.AddEndpointsApiExplorer();
builder.Services.AddHealthChecks();

// Register application services
builder.Services.AddSingleton<{Entity}Store>();

// Configure SPAS SDK
builder.Services.AddSpasMetadata();
builder.Services.AddSpasServices(builder.Configuration, "{name}");

// Configure EventPublisher for sidecar communication
builder.Services.AddSingleton<EventPublisher>(sp =>
{
    var sidecarUrl = Environment.GetEnvironmentVariable("SIDECAR_URL") ?? "http://localhost:7000";
    var serviceName = Environment.GetEnvironmentVariable("SERVICE_NAME") ?? "{name}";
    
    var httpClient = new HttpClient { BaseAddress = new Uri(sidecarUrl) };
    return new EventPublisher(httpClient, serviceName);
});

var app = builder.Build();

app.MapHealthChecks("/health");

// Define minimal API endpoints inline with SPAS attributes
// Command: Create a new {entity} - produces {entity}-created event
app.MapPost("/{entity}s",
    [SpasCommand("Create{Entity}", "1.0", 
        Description = "Creates a new {entity}",
        Produces = new[] { typeof({Entity}CreatedEvent) })]
    async (Create{Entity}Request request, EventPublisher publisher, {Entity}Store store) =>
    {
        var entity = new {Entity}
        {
            Id = Guid.NewGuid().ToString(),
            // Map request properties to entity
        };
        
        store.Add(entity);
        
        var eventData = new {Entity}CreatedEvent(entity.Id, entity.CustomerId, DateTimeOffset.UtcNow);
        await publisher.PublishAsync(eventData);
        
        return Results.Created($"/{entity}s/{entity.Id}", Create{Entity}Response.From(entity));
    });

// Query: Get {entity} by ID
app.MapGet("/{entity}s/{id}",
    [SpasQuery("Get{Entity}", "1.0", Description = "Retrieves a {entity} by ID")]
    ({Entity}Store store, string id) =>
    {
        var entity = store.GetById(id);
        return entity is not null ? Results.Ok(entity) : Results.NotFound();
    });

// Query: List all {entity}s
app.MapGet("/{entity}s",
    [SpasQuery("List{Entity}s", "1.0", Description = "Lists all {entity}s")]
    ({Entity}Store store) => Results.Ok(store.GetAll()));

// Run with SPAS service identity
await app.RunSpasServiceAsync(args, options =>
{
    options.ServiceId = "{name}";
    options.ServiceName = "{Human-Readable Name}";
    options.Version = "1.0.0";
    options.BoundedContext = "{context}";
    options.Description = "{description}";
    
    options.AddCapability("{entity}-management");
    
    options.ConfigureConsistency(c => c.WithCommands("ACID").WithQueries("EVENTUAL"));
    options.ConfigureSecurity(s => s
        .WithAuthenticationType("jwt")
        .AddRequiredScope("{entity}.read")
        .AddRequiredScope("{entity}.write")
        .AddDataClassification("internal"));
});
```

#### Event Class with [SpasEvent] Attribute

```csharp
using Spas.Sdk.Metadata.Attributes;

namespace {Name}.Events;

/// <summary>
/// Event published when a new {entity} is created.
/// CloudEvents type: com.{context}.{entity}-created
/// </summary>
[SpasEvent("{Entity}Created", "1.0.0")]
public record {Entity}CreatedEvent(
    string Id,
    string CustomerId,
    DateTimeOffset CreatedAt
);
```

#### DTOs

```csharp
namespace {Name}.DTOs;

public record Create{Entity}Request(
    string CustomerId,
    List<LineItem> Items
);

public record Create{Entity}Response(
    string Id,
    string CustomerId,
    DateTimeOffset CreatedAt
)
{
    public static Create{Entity}Response From({Entity} entity) => 
        new(entity.Id, entity.CustomerId, entity.CreatedAt);
}

public record LineItem(string ProductId, int Quantity);
```

#### Simple Store (In-Memory)

```csharp
namespace {Name}.Services;

public class {Entity}Store
{
    private readonly List<{Entity}> _entities = new();
    
    public void Add({Entity} entity) => _entities.Add(entity);
    public {Entity}? GetById(string id) => _entities.FirstOrDefault(e => e.Id == id);
    public IEnumerable<{Entity}> GetAll() => _entities.AsReadOnly();
}
```

