/* inbound-order-confirmed.jsonata */
/* Transforms order-confirmed (order-service) -> activate-subscription (subscription-service) */
/* Source: OrderConfirmedEvent { orderId, status, reservedItems[], shippingAddress?, referenceId? } */
/* Target: ActivateSubscriptionRequest { orderId, status, referenceId? } */
{
  "orderId": orderId,
  "status": status,
  "referenceId": referenceId
}
