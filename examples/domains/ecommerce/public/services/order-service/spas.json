{
  "schemaVersion": "design-time-metadata-v1",
  "id": "order-service",
  "name": "order-service",
  "description": "Order lifecycle management service",
  "version": "1.0.0",
  "boundedContext": "order",
  "capabilities": [
    "order-management"
  ],
  "endpoints": [],
  "events": [
    {
      "type": "order-created",
      "version": "1.0",
      "schemaRef": "schemas/events/order-created.schema.json"
    },
    {
      "type": "order-requested",
      "version": "1.0",
      "schemaRef": "schemas/events/order-requested.schema.json"
    },
    {
      "type": "stock-reserved",
      "version": "1.0",
      "schemaRef": "schemas/events/stock-reserved.schema.json"
    }
  ],
  "consistency": {
    "commands": "ACID",
    "queries": "EVENTUAL"
  },
  "network": {
    "requiredEgress": [
      "localhost:6379"
    ]
  },
  "security": {
    "authentication": {
      "type": "jwt",
      "requiredScopes": [
        "orders.read",
        "orders.write"
      ]
    },
    "dataClassification": [
      "internal"
    ]
  },
