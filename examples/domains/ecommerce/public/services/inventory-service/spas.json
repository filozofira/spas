{
  "schemaVersion": "design-time-metadata-v1",
  "id": "inventory-service",
  "name": "inventory-service",
  "description": "Stock tracking and reservation service",
  "version": "1.0.0",
  "boundedContext": "inventory",
  "capabilities": [
    "inventory-tracking"
  ],
  "endpoints": [],
  "events": [
    {
      "type": "order-created",
      "version": "1.0",
      "schemaRef": "schemas/events/order-created.schema.json"
    },
    {
      "type": "stock-reserved",
      "version": "1.0",
      "schemaRef": "schemas/events/stock-reserved.schema.json"
    },
    {
      "type": "stock-depleted",
      "version": "1.0",
      "schemaRef": "schemas/events/stock-depleted.schema.json"
    }
  ],
  "consistency": {
    "commands": "ACID",
    "queries": "EVENTUAL"
  },
  "network": {
    "requiredEgress": [
      "localhost:6379"
    ]
  },
  "security": {
    "authentication": {
      "type": "jwt",
      "requiredScopes": [
        "inventory.read"
      ]
    },
    "dataClassification": [
      "internal"
    ]
  },
  "license": "MIT",
  "publishedAt": "2025-12-16T23:03:23.563Z",
  "runtime": {
    "digest": "sha256:sha256:999d034e18ce205d99d78431039c2a583f2480408b1c9f9d784a8c5b56b693d7",
    "repository": "spas-examples/inventory-service",
    "tag": "1.0.0",
    "image": "spas-examples/inventory-service@sha256:sha256:999d034e18ce205d99d78431039c2a583f2480408b1c9f9d784a8c5b56b693d7"
  }
}