{
  "schemaVersion": "runtime-metadata-v1",
  "id": "basket-service",
  "name": "Basket Service",
  "description": "Manages item collection baskets for users; publishes checkout events to trigger transaction creation and handles inventory updates",
  "version": "1.0.0",
  "boundedContext": "shopping",
  "capabilities": [
    "basket-management",
    "checkout-initiation"
  ],
  "endpoints": [
    {
      "name": "create-basket",
      "type": "Command",
      "protocol": "Http",
      "methodPath": "/api/baskets",
      "version": "1.0.0",
      "schemaRef": "schemas/endpoints/create-basket-request.schema.json",
      "description": "Creates a new basket for a user; emits BasketCreated event"
    },
    {
      "name": "list-baskets",
      "type": "Query",
      "protocol": "Http",
      "methodPath": "/api/baskets",
      "version": "1.0.0",
      "schemaRef": "schemas/endpoints/basket-response.schema.json",
      "description": "Lists all baskets (demo endpoint; returns in-memory state)"
    },
    {
      "name": "mark-product-unavailable",
      "type": "Command",
      "protocol": "Http",
      "methodPath": "/api/baskets/mark-unavailable",
      "version": "1.0.0",
      "schemaRef": "schemas/endpoints/stock-depleted-payload.schema.json",
      "description": "Marks an item as unavailable in all open baskets when quantity is depleted"
    },
    {
      "name": "initiate-checkout",
      "type": "Command",
      "protocol": "Http",
      "methodPath": "/api/baskets/{id}/checkout",
      "version": "1.0.0",
      "schemaRef": "schemas/endpoints/checkout-request.schema.json",
      "description": "Initiates checkout for a basket with destination address; emits CheckoutInitiated event containing all transaction details for downstream services"
    },
    {
      "name": "clear-basket",
      "type": "Command",
      "protocol": "Http",
      "methodPath": "/api/baskets/clear",
      "version": "1.0.0",
      "schemaRef": "schemas/endpoints/order-created-payload.schema.json",
      "description": "Clears a basket after successful transaction creation; matches basket via referenceId"
    },
    {
      "name": "remove-item",
      "type": "Command",
      "protocol": "Http",
      "methodPath": "/api/baskets/{id}/items/{productId}",
      "version": "1.0.0",
      "schemaRef": "schemas/endpoints/basket-response.schema.json",
      "description": "Removes an item from the basket; emits ItemRemoved event"
    },
    {
      "name": "get-basket",
      "type": "Query",
      "protocol": "Http",
      "methodPath": "/api/baskets/{id}",
      "version": "1.0.0",
      "schemaRef": "schemas/endpoints/basket-response.schema.json",
      "description": "Returns basket contents including item availability status"
    },
    {
      "name": "add-item",
      "type": "Command",
      "protocol": "Http",
      "methodPath": "/api/baskets/{id}/items",
      "version": "1.0.0",
      "schemaRef": "schemas/endpoints/add-item-request.schema.json",
      "description": "Adds an item to the basket; emits ItemAdded event"
    }
  ],
  "commands": [
    {
      "name": "create-basket",
      "version": "1.0.0",
      "produces": [
        {
          "type": "basket-created",
          "version": "1.0.0",
          "when": "success"
        }
      ]
    },
    {
      "name": "mark-product-unavailable",
      "version": "1.0.0",
      "produces": []
    },
    {
      "name": "initiate-checkout",
      "version": "1.0.0",
      "produces": [
        {
          "type": "checkout-initiated",
          "version": "1.0.0",
          "when": "success"
        }
      ]
    },
    {
      "name": "clear-basket",
      "version": "1.0.0",
      "produces": []
    },
    {
      "name": "remove-item",
      "version": "1.0.0",
      "produces": [
        {
          "type": "item-removed",
          "version": "1.0.0",
          "when": "success"
        }
      ]
    },
    {
      "name": "add-item",
      "version": "1.0.0",
      "produces": [
        {
          "type": "item-added",
          "version": "1.0.0",
          "when": "success"
        }
      ]
    }
  ],
  "events": [
    {
      "type": "basket-created",
      "version": "1.0.0",
      "schemaRef": "schemas/events/basket-created-event.schema.json",
      "description": "Emitted when a user creates a new basket"
    },
    {
      "type": "checkout-initiated",
      "version": "1.0.0",
      "schemaRef": "schemas/events/checkout-initiated-event.schema.json",
      "description": "Emitted when a customer initiates checkout; contains all order details including shipping address to enable order-service and fulfillment-service integration"
    },
    {
      "type": "item-added",
      "version": "1.0.0",
      "schemaRef": "schemas/events/item-added-event.schema.json",
      "description": "Emitted when a product is added to a shopping basket"
    },
    {
      "type": "item-removed",
      "version": "1.0.0",
      "schemaRef": "schemas/events/item-removed-event.schema.json",
      "description": "Emitted when a product is removed from a shopping basket"
    }
  ],
  "consistency": {
    "commands": "ACID",
    "queries": "EVENTUAL"
  },
  "security": {
    "authentication": {
      "type": "JWT",
      "requiredScopes": [
        "baskets.read",
        "baskets.write"
      ]
    },
    "dataClassification": [
      "internal"
    ]
  },
  "network": {
    "requiredEgress": [
      "localhost:6379"
    ]
  },
  "license": "MIT",
  "publishedAt": "2026-01-04T13:38:47.399Z",
  "runtime": {
    "digest": "sha256:TODO_UPDATE_AFTER_BUILD",
    "repository": "spas-examples/basket-service",
    "tag": "1.0.0",
    "image": "spas-examples/basket-service@sha256:TODO_UPDATE_AFTER_BUILD"
  }
}