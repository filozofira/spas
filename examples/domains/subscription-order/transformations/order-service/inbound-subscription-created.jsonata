/* inbound-subscription-created.jsonata */
/* Transforms subscription-created (subscription-service) -> create-order (order-service) */
/* Source schema: services/subscription-service/schemas/events/subscription-created.schema.json */
/* Target schema: services/order-service/schemas/endpoints/create-order.schema.json */

{
  "customerId": customerId,
  "items": $append([], {
    "productId": productId,
    "quantity": quantity,
    "price": 0
  }),
  "total": 0,
  "referenceId": subscriptionId
}
