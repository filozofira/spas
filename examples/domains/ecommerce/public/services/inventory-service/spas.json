{
  "schemaVersion": "design-time-metadata-v1",
  "id": "inventory-service",
  "name": "inventory-service",
  "description": "Stock tracking and reservation service",
  "version": "1.0.0",
  "boundedContext": "inventory",
  "capabilities": [
    "inventory-tracking"
  ],
  "endpoints": [],
  "events": [
    {
      "type": "OrderCreated",
      "version": "1.0",
      "schemaRef": "schemas/events/order-created.schema.json"
    },
    {
      "type": "StockReserved",
      "version": "1.0",
      "schemaRef": "schemas/events/stock-reserved.schema.json"
    },
    {
      "type": "StockDepleted",
      "version": "1.0",
      "schemaRef": "schemas/events/stock-depleted.schema.json"
    }
  ],
  "consistency": {
    "commands": "ACID",
    "queries": "EVENTUAL"
  },
  "network": {
    "requiredEgress": [
      "localhost:6379"
    ]
  },
  "security": {
    "authentication": {
      "type": "jwt",
      "requiredScopes": [
        "inventory.read"
      ]
    },
    "dataClassification": [
      "internal"
    ]
  },
  "license": "MIT",
  "publishedAt": "2025-12-15T21:05:29.622Z",
  "runtime": {
    "digest": "sha256:35a156ee3a7172fb68693ba19cc040d6a8cc389928c9d15240069e087a9e59ee",
    "repository": "spas-examples/inventory-service",
    "tag": "1.0.0",
    "image": "spas-examples/inventory-service@sha256:35a156ee3a7172fb68693ba19cc040d6a8cc389928c9d15240069e087a9e59ee"
  }
}