{
  "schemaVersion": "design-time-metadata-v1",
  "id": "inventory-service",
  "name": "inventory-service",
  "description": "Stock tracking and reservation service",
  "version": "1.0.0",
  "boundedContext": "inventory",
  "capabilities": [
    "inventory-tracking"
  ],
  "endpoints": [],
  "events": [
    {
      "type": "order-created",
      "version": "1.0",
      "schemaRef": "schemas/events/order-created.schema.json"
    },
    {
      "type": "stock-reserved",
      "version": "1.0",
      "schemaRef": "schemas/events/stock-reserved.schema.json"
    },
    {
      "type": "stock-depleted",
      "version": "1.0",
      "schemaRef": "schemas/events/stock-depleted.schema.json"
    }
  ],
  "consistency": {
    "commands": "ACID",
    "queries": "EVENTUAL"
  },
  "network": {
    "requiredEgress": [
      "localhost:6379"
    ]
  },
  "security": {
    "authentication": {
      "type": "jwt",
      "requiredScopes": [
        "inventory.read"
      ]
    },
    "dataClassification": [
      "internal"
    ]
  },
  "license": "MIT",
  "publishedAt": "2025-12-17T00:53:04.428Z",
  "runtime": {
    "digest": "sha256:25d207d85da46149b900bf529027412f2cfffb7874ba70803ee61b89233c9c2c",
    "repository": "spas-examples/inventory-service\n",
    "tag": "1.0.0",
    "image": "spas-examples/inventory-service\n@sha256:25d207d85da46149b900bf529027412f2cfffb7874ba70803ee61b89233c9c2c"
  }
}