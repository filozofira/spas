{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AddProductRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "productId",
    "name",
    "category",
    "price",
    "description"
  ],
  "properties": {
    "productId": {
      "type": "string",
      "maxLength": 50,
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "maxLength": 200,
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "price": {
      "type": "number",
      "format": "decimal",
      "minimum": 0
    },
    "description": {
      "type": "string",
      "maxLength": 2000,
      "minLength": 1
    }
  }
}